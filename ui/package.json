{
  "name": "enhanced-confluence-search-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:views && npm run build:options && npm run build:content",
    "build:views": "vite build",
    "build:options": "vite build --config vite.options.config.js",
    "build:content": "vite build --config vite.content.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^26.1.0",
    "vite": "^6.3.5",
    "vitest": "^2.1.8"
  }
}
