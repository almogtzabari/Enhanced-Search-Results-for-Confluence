{
  "manifest_version": 3,
  "name": "Enhanced Search Results for Confluence",
  "version": "2.0.1",
  "description": "Enhances search functionality on Confluence pages.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/content-main.js",
        "views/index.html",
        "shared/runtime/dbService.js",
        "shared/extensionConfig.js",
        "extension/content/modalStyles.css",
        "assets/icons/favicon.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icons/extension-icon.png",
    "48": "assets/icons/extension-icon.png",
    "128": "assets/icons/extension-icon.png"
  }
}
